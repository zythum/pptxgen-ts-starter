{
  "name": "pptxgen-ts-starter",
  "version": "1.0.0",
  "description": "A starter template for creating PowerPoint presentations using JSX and TypeScript with pptxgenjs",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts src/ppt.tsx",
    "generate": "tsx scripts/generate.ts src/ppt.tsx -o output/presentation.pptx"
  },
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "jsx",
    "typescript",
    "template",
    "starter"
  ],
  "license": "MIT",
  "dependencies": {
    "@artifact-kit/pptxgenjs-jsx": "^0.1.6",
    "@silurus/ooxml": "^0.74.1",
    "arg": "^5.0.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
