{
  "name": "pptxgen-ts-starter",
  "version": "1.0.0",
  "description": "A starter template for creating PowerPoint presentations using JSX and TypeScript with pptxgenjs",
  "keywords": [
    "jsx",
    "powerpoint",
    "pptx",
    "presentation",
    "starter",
    "template",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts src/ppt.tsx --open",
    "generate": "tsx scripts/generate-pptx.ts src/ppt.tsx -o output/presentation.pptx",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@silurus/ooxml": "^0.74.6",
    "@zythum02/pptxgenjsx": "^0.1.6",
    "color": "^5.0.3",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/node": "^24.13.3",
    "arg": "^5.0.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.74.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
